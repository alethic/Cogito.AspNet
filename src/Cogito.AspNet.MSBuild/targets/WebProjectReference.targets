<Project>
    <PropertyGroup>
        <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    </PropertyGroup>

    <!--

        WebProjectReference

        References to Web Application Projects whose publish output is imported into the
        output of the containing project. Distinct from ProjectReference: the referenced
        project's assembly is not referenced; only its published content is consumed.

            <ItemGroup>
                <WebProjectReference Include="..\My.Web\My.Web.csproj">
                    <WebTargetPath>My.Web\</WebTargetPath>
                    <WebPublishMethod>FileSystem</WebPublishMethod>
                    <WebProperties>PrecompileBeforePublish=true</WebProperties>
                </WebProjectReference>
            </ItemGroup>

        The referenced project is published through the Web Publishing Pipeline (its
        WebPublish target) to the referenced project's own default output location, which is
        queried back (GetWebPublishPath) and imported — the same query-don't-dictate shape as
        PublishProjectReference. By default NOTHING is added to the referenced project's global
        properties, so the import resolves to the very same project instance the rest of the
        build (e.g. the solution) uses: MSBuild's scheduler serializes all work on one instance
        (no concurrent builds of the same project racing over shared bin/obj), the publish runs
        once, and repeated imports are satisfied from the target result cache — with the
        queried path still answering and the output still on disk to collect. For the same
        reason nothing on the importing side may clean or redirect that output.

        The referenced project declares how it publishes by setting WebPublishMethod as an
        ordinary project property (it selects the Web Publishing Pipeline's Deploy import at
        evaluation time, so it cannot be set in a target):

            <PropertyGroup>
                <WebPublishMethod>Package</WebPublishMethod>
            </PropertyGroup>

        Supported for import: FileSystem (the published site is imported as a directory tree)
        and Package (the deployment package and its sidecar files are imported). A Visual
        Studio publish profile still overrides the property, so interactive publishing is
        unaffected.

        The referenced project must itself reference this package (GetWebPublishPath has to be
        defined in its scope); an unknown-target error from the import dispatch means it does
        not.

        WebTargetPath: relative directory under the containing project's output where the
        imported output is placed. Defaults to the referenced project's name.

        WebProperties: additional semicolon-separated MSBuild properties passed to the
        referenced project's publish. These enter the referenced project's global property
        identity, splitting it into a second instance — which duplicates work and, under
        parallel builds, races the plain instance over the same bin/obj. Leave it unset
        unless the split is genuinely intended.

    -->

    <PropertyGroup>
        <AssignWebProjectConfigurationDependsOn>
            $(AssignWebProjectConfigurationDependsOn);
        </AssignWebProjectConfigurationDependsOn>
    </PropertyGroup>

    <Target Name="AssignWebProjectConfiguration" DependsOnTargets="$(AssignWebProjectConfigurationDependsOn)" Condition=" '$(DesignTimeBuild)' != 'true' And '@(WebProjectReference)' != '' ">
        <PropertyGroup>
            <OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration Condition="'$(OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration)' == ''">true</OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration>
            <ShouldUnsetParentConfigurationAndPlatform Condition="'$(ShouldUnsetParentConfigurationAndPlatform)' == '' and ('$(BuildingInsideVisualStudio)' == 'true' or '$(BuildingSolutionFile)' == 'true')">true</ShouldUnsetParentConfigurationAndPlatform>
            <ShouldUnsetParentConfigurationAndPlatform Condition="'$(ShouldUnsetParentConfigurationAndPlatform)' == ''">false</ShouldUnsetParentConfigurationAndPlatform>
        </PropertyGroup>
        <AssignProjectConfiguration ProjectReferences="@(WebProjectReference)" CurrentProject="$(MSBuildProjectFullPath)" CurrentProjectConfiguration="$(Configuration)" CurrentProjectPlatform="$(Platform)" DefaultToVcxPlatformMapping="$(DefaultToVcxPlatformMapping)" VcxToDefaultPlatformMapping="$(VcxToDefaultPlatformMapping)" OutputType="$(OutputType)" ResolveConfigurationPlatformUsingMappings="false" SolutionConfigurationContents="$(CurrentSolutionConfigurationContents)" AddSyntheticProjectReferencesForSolutionDependencies="false" OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration="$(OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration)" ShouldUnsetParentConfigurationAndPlatform="$(ShouldUnsetParentConfigurationAndPlatform)">
            <Output TaskParameter="AssignedProjects" ItemName="_WebProjectReferenceWithConfiguration"/>
            <Output TaskParameter="UnassignedProjects" ItemName="_WebProjectReferenceWithConfiguration"/>
        </AssignProjectConfiguration>
    </Target>

    <Target Name="GetWebProjectReferences" DependsOnTargets="AssignWebProjectConfiguration" Condition=" '$(DesignTimeBuild)' != 'true' And '@(_WebProjectReferenceWithConfiguration)' != '' ">
        <ItemGroup>
            <_WebProjectReference Remove="@(_WebProjectReference)" />
            <_WebProjectReference Include="@(_WebProjectReferenceWithConfiguration)">
                <WebProjectName>$([System.IO.Path]::GetFileNameWithoutExtension('%(Identity)'))</WebProjectName>
            </_WebProjectReference>
        </ItemGroup>
        <ItemGroup>
            <_WebProjectReference Update="@(_WebProjectReference)">
                <WebTargetPath Condition=" '%(_WebProjectReference.WebTargetPath)' == '' ">%(_WebProjectReference.WebProjectName)</WebTargetPath>
            </_WebProjectReference>
            <_WebProjectReference Update="@(_WebProjectReference)">
                <WebTargetPath>$([MSBuild]::EnsureTrailingSlash('%(_WebProjectReference.WebTargetPath)'))</WebTargetPath>
            </_WebProjectReference>
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <BuildWebProjectReferencesDependsOn>
            $(BuildWebProjectReferencesDependsOn);
            GetWebProjectReferences;
        </BuildWebProjectReferencesDependsOn>
    </PropertyGroup>

    <!-- Batches per referenced project so each import lands under its own WebTargetPath. -->
    <Target
        Name="BuildWebProjectReferences"
        DependsOnTargets="$(BuildWebProjectReferencesDependsOn)"
        Inputs="@(_WebProjectReference)"
        Outputs="%(Identity)\%(WebTargetPath).null"
        Condition=" '$(DesignTimeBuild)' != 'true' And '@(_WebProjectReference)' != '' ">
        <PropertyGroup>
            <_WebImportTargetPath>%(_WebProjectReference.WebTargetPath)</_WebImportTargetPath>
            <_WebImportProperties>%(_WebProjectReference.WebProperties)</_WebImportProperties>
        </PropertyGroup>

        <!-- Publish through the Web Publishing Pipeline to the referenced project's own default
             output location, and query that location (and the method it used) back. Nothing
             caller-specific enters the referenced project's global properties, so every importer
             resolves to the same instance and repeated imports are answered from the target
             result cache — with the path still returned and the previously produced output still
             on disk. Nothing on this side may clean or redirect that output. -->
        <ItemGroup>
            <_WebImportResult Remove="@(_WebImportResult)" />
        </ItemGroup>
        <MSBuild
            Projects="@(_WebProjectReference)"
            Targets="WebPublish;GetWebPublishPath"
            BuildInParallel="$(BuildInParallel)"
            Properties="%(_WebProjectReference.SetConfiguration);%(_WebProjectReference.SetPlatform);%(_WebProjectReference.SetTargetFramework);$(_WebImportProperties)"
            RemoveProperties="$(_GlobalPropertiesToRemoveFromProjectReferences);%(_WebProjectReference.GlobalPropertiesToRemove);DesignTimeBuild;BuildProjectReferences">
            <Output TaskParameter="TargetOutputs" ItemName="_WebImportResult" />
        </MSBuild>

        <PropertyGroup>
            <_WebImportResolvedPath>@(_WebImportResult)</_WebImportResolvedPath>
            <_WebImportResolvedMethod>@(_WebImportResult->'%(WebPublishMethod)')</_WebImportResolvedMethod>
        </PropertyGroup>
        <Error
            Condition=" '$(_WebImportResolvedMethod)' != 'FileSystem' And '$(_WebImportResolvedMethod)' != 'Package' "
            Text="WebProjectReference '%(_WebProjectReference.Identity)' published with WebPublishMethod '$(_WebImportResolvedMethod)', which cannot be imported. Supported values: FileSystem, Package — set one as a project property in the referenced project." />
        <Message Importance="Normal" Text="Importing web project %(_WebProjectReference.WebProjectName) ($(_WebImportResolvedMethod)) to $(_WebImportTargetPath)" />

        <PropertyGroup>
            <!-- Package returns the package file; the import is its sidecar family (X.zip,
                 X.deploy.cmd, X.SetParameters.xml, ...), deliberately non-recursive so the
                 intermediate PackageTmp and Log directories beside it are not swept up.
                 FileSystem returns the publish directory; the import is its whole tree. -->
            <_WebImportPublishDir Condition=" '$(_WebImportResolvedMethod)' == 'FileSystem' ">$([MSBuild]::EnsureTrailingSlash('$(_WebImportResolvedPath)'))</_WebImportPublishDir>
            <_WebImportPublishDir Condition=" '$(_WebImportResolvedMethod)' == 'Package' ">$([System.IO.Path]::GetDirectoryName('$(_WebImportResolvedPath)'))\</_WebImportPublishDir>
            <_WebImportPublishName Condition=" '$(_WebImportResolvedMethod)' == 'Package' ">$([System.IO.Path]::GetFileNameWithoutExtension('$(_WebImportResolvedPath)'))</_WebImportPublishName>
        </PropertyGroup>

        <ItemGroup>
            <__WebImportFile Condition=" '$(_WebImportResolvedMethod)' == 'Package' " Include="$(_WebImportPublishDir)$(_WebImportPublishName).*" />
            <__WebImportFile Condition=" '$(_WebImportResolvedMethod)' == 'FileSystem' " Include="$(_WebImportPublishDir)**\*" />
            <__WebImportFile Update="@(__WebImportFile)">
                <DestinationRelativePath>%(__WebImportFile.RecursiveDir)%(__WebImportFile.Filename)%(__WebImportFile.Extension)</DestinationRelativePath>
            </__WebImportFile>
        </ItemGroup>

        <ItemGroup>
            <_WebImportFile Include="@(__WebImportFile)">
                <WebTargetPath>$(_WebImportTargetPath)</WebTargetPath>
            </_WebImportFile>
            <__WebImportFile Remove="@(__WebImportFile)" />
        </ItemGroup>
    </Target>

    <!-- Runs in the REFERENCED project. The Web Publishing Pipeline has no default publishUrl
         for the FileSystem method, so default it under the referenced project's own
         intermediate output — a location that is identical for every importer. -->
    <Target Name="_InitWebPublishPathDefaults" BeforeTargets="WebPublish" Condition=" '$(WebPublishMethod)' == 'FileSystem' ">
        <PropertyGroup>
            <publishUrl Condition=" '$(publishUrl)' == '' ">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)webpublish'))\</publishUrl>
        </PropertyGroup>
    </Target>

    <PropertyGroup>
        <GetWebPublishPathDependsOn>
            $(GetWebPublishPathDependsOn);
            WebPublish;
        </GetWebPublishPathDependsOn>
    </PropertyGroup>

    <!-- Runs in the REFERENCED project: returns where the Web Publishing Pipeline put this
         project's publish output — the package file for the Package method, the publish
         directory for FileSystem — with the method carried as metadata so the importer can
         collect accordingly without dictating it. The WebProjectReference analogue of
         GetPublishProjectPath: because it is a Returns target, it answers from the target
         result cache even when WebPublish itself was satisfied without re-executing. -->
    <Target Name="GetWebPublishPath" DependsOnTargets="$(GetWebPublishPathDependsOn)" Returns="@(GetWebPublishPath)">
        <PropertyGroup>
            <_GetWebPublishPath Condition=" '$(WebPublishMethod)' == 'Package' ">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PackageFileName)'))))</_GetWebPublishPath>
            <_GetWebPublishPath Condition=" '$(WebPublishMethod)' == 'FileSystem' ">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(publishUrl)'))))</_GetWebPublishPath>
        </PropertyGroup>
        <ItemGroup>
            <GetWebPublishPath Remove="@(GetWebPublishPath)" />
            <GetWebPublishPath Include="$(_GetWebPublishPath)" Condition=" '$(_GetWebPublishPath)' != '' ">
                <WebPublishMethod>$(WebPublishMethod)</WebPublishMethod>
            </GetWebPublishPath>
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <CollectWebProjectReferenceItemsDependsOn>
            $(CollectWebProjectReferenceItemsDependsOn);
            AssignWebProjectConfiguration;
            GetWebProjectReferences;
            BuildWebProjectReferences;
        </CollectWebProjectReferenceItemsDependsOn>
    </PropertyGroup>

    <Target
        Name="CollectWebProjectReferenceItems"
        BeforeTargets="GetCopyToOutputDirectoryItems"
        DependsOnTargets="$(CollectWebProjectReferenceItemsDependsOn)"
        Condition=" '$(DesignTimeBuild)' != 'true' And '@(WebProjectReference)' != '' ">
        <ItemGroup>
            <ContentWithTargetPath Include="@(_WebImportFile)">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <TargetPath>%(_WebImportFile.WebTargetPath)%(_WebImportFile.DestinationRelativePath)</TargetPath>
            </ContentWithTargetPath>
        </ItemGroup>
    </Target>

</Project>
